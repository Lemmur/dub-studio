{
	"mcpServers": {
		"filesystem": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-filesystem",
				"C:/Users/ОТ/Desktop/dub/dub-studio"
			],
			"alwaysAllow": [
				"read_file",
				"read_text_file",
				"read_media_file",
				"read_multiple_files",
				"write_file",
				"edit_file",
				"create_directory",
				"list_directory",
				"list_directory_with_sizes",
				"directory_tree",
				"move_file",
				"search_files",
				"get_file_info",
				"list_allowed_directories"
			]
		},
		"fetch": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-fetch"
			]
		},
		"memory": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-memory"
			],
			"alwaysAllow": [
				"create_relations",
				"create_entities",
				"add_observations",
				"delete_entities",
				"delete_observations",
				"delete_relations",
				"read_graph",
				"search_nodes",
				"open_nodes"
			]
		},
		"sqlite": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-sqlite",
				"--db-path",
				"C:/Users/ОТ/Desktop/dub/dub-studio/MyDub/lines.db"
			]
		},
		"git": {
			"command": "uvx",
			"args": [
				"mcp-server-git",
				"--repository",
				"C:/Users/ОТ/Desktop/dub/dub-studio"
			]
		},
		"github": {
			"command": "docker",
			"args": [
				"run",
				"-i",
				"--rm",
				"-e",
				"GITHUB_PERSONAL_ACCESS_TOKEN",
				"ghcr.io/github/github-mcp-server"
			],
			"env": {
				"GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
			}
		}
	}
}